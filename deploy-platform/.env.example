# docker compose 同级。不要把填了值的 .env 提交进 Git。
#
# JWT_SECRET / AES_KEY：已在跑的环境必须用现网 data/.secrets.json 里的原值，
# 不要新随机一把，否则库里的 Git 凭证解不开。空则首次启动自动生成。
# 示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
AES_KEY=
#
# 后端与隔离 Runner 进程间认证。空则写入数据卷，两边共用。
HARNESS_RUNNER_TOKEN=
#
# 容器内 MySQL root 口令。compose 必填，不要用仓库里的演示值上生产。
MYSQL_ROOT_PASSWORD=
#
# 后端完整连接串。compose 原样传入，不要在 yml 里拼密码。
# 用户、密码必须和 MYSQL_ROOT_PASSWORD 一致（默认用户 root），主机名在 compose 网络里是 mysql。
# 例：mysql+pymysql://root:与MYSQL_ROOT_PASSWORD相同@mysql:3306/deploy_platform?charset=utf8mb4
DATABASE_URL=
#
# Redis 口令。compose 必填；后端通过 REDIS_PASSWORD 覆盖平台设置。
REDIS_PASSWORD=
#
# Elasticsearch 由 compose 默认拉起（容器内 http://elasticsearch:9200）。
# 首次写入平台设置；之后以设置页为准。自备集群时改设置页即可，也可在此覆盖首次写入：
# ES_HOSTS=http://elasticsearch:9200
#
# 首次建库时管理员口令。空则仍用演示口令 admin123（只适合测试机）。
# 生产必须设一个足够长的值。已改过密的库不会被覆盖。
BOOTSTRAP_ADMIN_PASSWORD=
#
# 浏览器跨域白名单，逗号分隔。空则只用平台设置里的 public_app_base。
CORS_ORIGINS=
